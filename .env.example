# Copy to .env and fill in. Never commit .env.

# SQLAlchemy connection string. Railway/Heroku-style postgres:// URLs are
# normalized automatically, so pasting a managed DATABASE_URL as-is works.
DATABASE_URL=postgresql+psycopg://jobwatch:jobwatch@localhost:5432/jobwatch

# Telegram alerts (leave empty to run without alerting).
# Bot token: talk to @BotFather. Chat id: message your bot once, then
# https://api.telegram.org/bot<TOKEN>/getUpdates shows it.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Seconds between polls when running with --loop.
POLL_INTERVAL_SECONDS=3600
